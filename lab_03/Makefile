####### Compile

camera.o: camera.cpp camera.h \
		base_camera.h \
		invisible_object.h \
		object.h \
		point.h \
		drawer_visitor.h \
		base_visitor.h \
		base_drawer.h \
		skeleton_model.h \
		base_model.h \
		visible_object.h \
		base_model_structure.h \
		edge.h \
		composite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o camera.o camera.cpp

composite.o: composite.cpp composite.h \
		object.h \
		base_visitor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o composite.o composite.cpp

draw_manager.o: draw_manager.cpp draw_manager.h \
		base_manager.h \
		base_visitor.h \
		scene.h \
		object.h \
		composite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o draw_manager.o draw_manager.cpp

drawer_visitor.o: drawer_visitor.cpp drawer_visitor.h \
		base_visitor.h \
		base_drawer.h \
		point.h \
		skeleton_model.h \
		base_model.h \
		visible_object.h \
		object.h \
		base_model_structure.h \
		edge.h \
		composite.h \
		base_camera.h \
		invisible_object.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o drawer_visitor.o drawer_visitor.cpp

edge.o: edge.cpp edge.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o edge.o edge.cpp

list_model_structure.o: list_model_structure.cpp list_model_structure.h \
		base_model_structure.h \
		point.h \
		edge.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o list_model_structure.o list_model_structure.cpp

main.o: main.cpp skeleton_model.h \
		base_model.h \
		visible_object.h \
		object.h \
